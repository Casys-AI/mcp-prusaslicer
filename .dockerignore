# Version control
.git

# Deno local cache (not the /deno-dir/ baked into the image)
.deno/

# Node artefacts
node_modules/

# Tests and test fixtures — not needed at runtime.
# Keep tests/ out of the image; integration tests run against a live container.
tests/

# Generator scripts — used only in development to (re)generate test fixtures.
# stdio-shim.ts is needed at runtime (stdio mode) so it is re-included below.
scripts/
!scripts/stdio-shim.ts

# Editor/OS
.DS_Store
